+/* separable gaussian blur, clamped borders */
+static void
+elan_blur (const float *src, float *dst, int w, int h, float sigma)
+{
+  int r = (int) (sigma * 3);
+  g_autofree float *kern = g_new (float, 2 * r + 1);
+  g_autofree float *tmp = g_new (float, w * h);
+  float ksum = 0;
+
+  for (int k = -r; k <= r; k++)
+    ksum += kern[k + r] = expf (-(k * k) / (2 * sigma * sigma));
+
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++)
+      {
+        float acc = 0;
+        for (int k = -r; k <= r; k++)
+          acc += kern[k + r] * src[y * w + CLAMP (x + k, 0, w - 1)];
+        tmp[y * w + x] = acc / ksum;
+      }
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++)
+      {
+        float acc = 0;
+        for (int k = -r; k <= r; k++)
+          acc += kern[k + r] * tmp[CLAMP (y + k, 0, h - 1) * w + x];
+        dst[y * w + x] = acc / ksum;
+      }
+}
+
+/* press sensors: submit the oldest kept frame (newer ones may be taken while
+ * the finger is being lifted), locally contrast-normalized (finger
+ * pressure changes contrast a lot) and upscaled 2x so SIFT finds enough
+ * keypoints */
+static void
+elan_submit_press_image (FpImageDevice *dev)
+{
+  FpiDeviceElan *self = FPI_DEVICE_ELAN (dev);
+  int size = self->frame_width * self->frame_height;
+  unsigned short *frame = g_slist_last (self->frames)->data;
+  g_autofree float *f = g_new (float, size);
+  g_autofree float *tmp = g_new (float, size);
+  g_autofree guint8 *norm = g_new (guint8, size);
+  int w = self->frame_width, h = self->frame_height;
+  FpImage *img = fp_image_new (w * 2, h * 2);
+
+  for (int i = 0; i < size; i++)
+    f[i] = frame[i];
+  elan_blur (f, tmp, w, h, 6);
+  for (int i = 0; i < size; i++)
+    {
+      f[i] -= tmp[i];
+      tmp[i] = f[i] * f[i];
+    }
+  elan_blur (tmp, tmp, w, h, 6);
+  for (int i = 0; i < size; i++)
+    norm[i] = CLAMP (f[i] / (sqrtf (tmp[i]) + 1e-3f) * 48 + 128, 0, 255);
+
+  /* bilinear 2x upscale (fpi_image_resize needs a 4-byte aligned width) */
+  for (int y = 0; y < h * 2; y++)
+    for (int x = 0; x < w * 2; x++)
+      {
+        float sx = CLAMP (x / 2.0f - 0.25f, 0, w - 1), sy = CLAMP (y / 2.0f - 0.25f, 0, h - 1);
+        int x0 = sx, y0 = sy, x1 = MIN (x0 + 1, w - 1), y1 = MIN (y0 + 1, h - 1);
+        float fx = sx - x0, fy = sy - y0;
+
+        img->data[y * w * 2 + x] =
+          (norm[y0 * w + x0] * (1 - fx) + norm[y0 * w + x1] * fx) * (1 - fy) +
+          (norm[y1 * w + x0] * (1 - fx) + norm[y1 * w + x1] * fx) * fy + 0.5f;
+      }
+
+  fpi_image_device_image_captured (dev, img);
+}
+
+/* press sensors: the background is read when a capture starts, often with the
+ * finger still on the sensor during repeated touches, which wipes out most of
+ * the print. An empty sensor reads flat (std dev ~75) and stable, so keep the
+ * last clean background and use it in place of a dirty one. A very dark
+ * background means the sensor isn't calibrated yet; calibration retakes it. */
+static void
+elan_press_fix_background (FpiDeviceElan *self)
+{
+  static unsigned short *clean_bg = NULL;
+  int size = self->frame_width * self->frame_height;
+  double sum = 0, sq = 0, mean;
+
+  for (int i = 0; i < size; i++)
+    {
+      sum += self->background[i];
+      sq += (double) self->background[i] * self->background[i];
+    }
+  mean = sum / size;
+
+  if (sqrt (sq / size - mean * mean) < 250)
+    {
+      g_free (clean_bg);
+      clean_bg = g_memdup2 (self->background, size * sizeof (short));
+    }
+  else if (clean_bg && mean > 1000)
+    {
+      fp_dbg ("finger on sensor during calibration, using previous background");
+      memcpy (self->background, clean_bg, size * sizeof (short));
+    }
+}
